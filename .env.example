# Supabase credentials — copy this file to .env and fill in real values
SUPABASE_URL=https://your-project-id.supabase.co

# Legacy service_role JWT key (starts with eyJ...)
# Get it from: Supabase dashboard → Settings → API Keys → "Legacy anon, service_role API keys" tab
# Required because the new sb_secret_xxx keys don't work with Storage yet.
SUPABASE_SERVICE_KEY=eyJ...

# Optional: new-format keys (kept for forward compatibility)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: OpenAI key (used for medical translation)
OPENAI_API_KEY=sk-...
